# Ignore node_modules in both frontend and backend
frontend/node_modules/
backend/node_modules/

# Ignore environment variables in both frontend and backend
frontend/.env
backend/.env

# Ignore lock files in both frontend and backend
frontend/package-lock.json
backend/package-lock.json
frontend/yarn.lock
backend/yarn.lock

# Ignore build directories (if applicable) in both frontend and backend
frontend/dist/
frontend/build/
backend/dist/
backend/build/

# Ignore log files
frontend/*.log
backend/*.log
*.log

# Optional npm cache directories
frontend/.npm
backend/.npm

# Ignore other common files and folders
frontend/.DS_Store
backend/.DS_Store
frontend/Thumbs.db
backend/Thumbs.db

# IDE and editor specific
frontend/.vscode/
backend/.vscode/
frontend/.idea/
backend/.idea/

# Miscellaneous
*.swp
*~
