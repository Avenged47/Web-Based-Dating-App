# Ignore node_modules in both frontend and backend
Frontend/node_modules/
Backend/node_modules/

# Ignore environment variables in both frontend and backend
Frontend/.env
Backend/.env

# Ignore lock files in both frontend and backend
Frontend/package-lock.json
Backend/package-lock.json
Frontend/yarn.lock
Backend/yarn.lock

# Ignore build directories (if applicable) in both frontend and backend
Frontend/dist/
Frontend/build/
Backend/dist/
Backend/build/

# Ignore log files
Frontend/*.log
Backend/*.log
*.log

# Optional npm cache directories
Frontend/.npm
Backend/.npm

# Ignore other common files and folders
Frontend/.DS_Store
Backend/.DS_Store
Frontend/Thumbs.db
Backend/Thumbs.db

# IDE and editor specific
Frontend/.vscode/
Backend/.vscode/
Frontend/.idea/
Backend/.idea/

# Miscellaneous
*.swp
*~
